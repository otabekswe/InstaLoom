# Run yarn setup:local, then fill .env.local. Never commit real credentials.

# Your permanent Vercel/custom domain; no path or trailing slash.
APP_URL=https://YOUR-PROJECT.vercel.app

# Meta → Instagram → API setup with Instagram business login.
# Copy Instagram app ID/secret here (not the App settings → Basic credentials).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional: leave empty to allow multiple Meta-authorized accounts, each in its own workspace.
# For tester-only access, keep the Meta app in Development and add Instagram testers.
# To restrict sign-in to one account, run yarn setup:owner and copy its numeric user_id.
OWNER_INSTAGRAM_ID=

# Generated by yarn setup:local (not a Meta access token).
# Copy the same value into Vercel and Meta → Instagram → Webhooks → Verify token.
WEBHOOK_VERIFY_TOKEN=

# Required on Vercel: Neon pooled Postgres URL from its Connect dialog.
# Leave empty locally to use SQLite (existing data/chatplace.db is preserved).
DATABASE_URL=
# DATABASE_PATH=data/instaloom.db

# Generated by yarn setup:local. Paste into Vercel as CRON_SECRET.
# Protects /api/cron/maintenance; Vercel sends it as a Bearer token.
# For free recovery, also set cron-job.org's Authorization header to Bearer <this value>.
# Use APP_URL/api/cron/maintenance?background=1 every 15 minutes (see README).
CRON_SECRET=

# Public contact shown on /privacy and /data-deletion; fill before going Live.
PRIVACY_CONTACT_NAME=
# Set either email or a public HTTPS contact URL (or both).
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_URL=

INSTAGRAM_API_VERSION=v25.0

# Restart yarn dev or redeploy after changing values.
# Meta → Instagram business login → Valid OAuth Redirect URIs:
# APP_URL/api/auth/instagram/callback
# Meta → Instagram → Webhooks → Callback URL:
# APP_URL/api/webhook
# Meta → App settings → Basic → Privacy Policy URL:
# APP_URL/privacy
# Meta → App settings → Basic → User data deletion → Data deletion instructions URL:
# APP_URL/data-deletion
# Settings in InstaLoom has copy buttons for all four URLs.
